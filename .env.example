# Resend email delivery. The sender must use a domain verified in Resend.
NUXT_RESEND_API_KEY=re_replace_with_a_resend_api_key
NUXT_CONTACT_TO_EMAIL=your-existing-inbox@example.com
NUXT_CONTACT_FROM_EMAIL=Hypnoshroom website <enquiries@mail.hypnoshroom.com>

# Optional public fallback. Leave blank until this address can receive email.
NUXT_PUBLIC_CONTACT_EMAIL=

# Optional locally, recommended in production. Configure both values together.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_a_cloudflare_turnstile_site_key
NUXT_TURNSTILE_SECRET_KEY=replace_with_a_cloudflare_turnstile_secret_key

# Employer accounts and contract board. Both values are public.
NUXT_PUBLIC_EMPLOYER_SUPABASE_URL=
NUXT_PUBLIC_EMPLOYER_SUPABASE_KEY=
