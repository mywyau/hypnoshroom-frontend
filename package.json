    "highlight.js": "^11.12.0",
    "nuxt": "^3.17.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "oxlint": "^1.95.0",
    "typescript": "^5.8.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
